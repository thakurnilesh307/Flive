# Copy to .env and fill in. .env is gitignored; never commit real values.

# Live ADS-B provider. Leave both empty to use adsb.fi open data (no key).
# Example for adsb.lol with a key:
#   ADSB_URL=https://api.adsb.lol/v2/point/{lat}/{lon}/{nm}
ADSB_URL=
ADSB_API_KEY=

# Ask Flive (local LLM via Ollama). Defaults shown; leave empty to use them.
#   OLLAMA_URL=http://127.0.0.1:11434
#   OLLAMA_MODEL=qwen3:8b       (needs tool calling; run: ollama pull qwen3:8b)
#   OLLAMA_THINK=false          (true enables slow "thinking" on models that support it)
OLLAMA_URL=
OLLAMA_MODEL=
OLLAMA_THINK=

# OpenSky API client (account page -> API client), used by poll_logan.py and
# later the nightly arrivals check. Optional: without them
# the poller runs anonymously with much tighter rate limits.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
