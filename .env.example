# Copy to .env and fill in. .env is gitignored; never commit real values.

# Live ADS-B provider. Leave both empty to use adsb.fi open data (no key).
# Example for adsb.lol with a key:
#   ADSB_URL=https://api.adsb.lol/v2/point/{lat}/{lon}/{nm}
ADSB_URL=
ADSB_API_KEY=

# Ask Flive (local LLM via Ollama). Defaults shown; leave empty to use them.
#   OLLAMA_URL=http://127.0.0.1:11434
#   OLLAMA_MODEL=qwen3:8b       (needs tool calling; run: ollama pull qwen3:8b)
#   OLLAMA_THINK=false          (true enables slow "thinking" on models that support it)
OLLAMA_URL=
OLLAMA_MODEL=
OLLAMA_THINK=

# OpenSky API client (account page -> API client). Used by the worldwide feed
# (world_feed.py) and later the nightly arrivals check. Without it the world
# feed runs anonymously: 400 credits/day = one global update every 15 minutes.
# With it: 4,000/day = one every ~90 s.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Worldwide feed. WORLD_FEED=off disables it. WORLD_POLL_SECONDS overrides the
# interval (min 45; only go below 90 with an active-feeder 8,000-credit account).
WORLD_FEED=
WORLD_POLL_SECONDS=
