data/history/
# Model datasets/artifacts per airport (dataset.py, train_eta.py, train_runway.py)
data/models/
data/eta_*
data/runway_*
# Log of scripts/overnight.sh
data/overnight.log
# Live prediction scores (score_predictions.py)
data/scores/
# Logs from a duplicate server, kept out of training and scoring
data/duplicate_logs/
# Time lost on arrival (time_lost.py) and run logs
data/time_lost/
data/scheduler/
data/*.log
